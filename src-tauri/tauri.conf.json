{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipDeck",
  "version": "0.1.0",
  "identifier": "com.tanmayangarkar.clipdeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Tanmay Angarkar",
    "copyright": "Copyright (c) 2026 Tanmay Angarkar",
    "category": "Productivity",
    "shortDescription": "Clipboard history with a fast floating dashboard",
    "longDescription": "ClipDeck keeps a local history of everything you copy (text, rich text, images and files) and lets you paste any of it from a floating dashboard opened with Ctrl+Shift+V.",
    "license": "PolyForm-Noncommercial-1.0.0",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
